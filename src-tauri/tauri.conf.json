{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WidgetBoard",
  "version": "0.16.0",
  "identifier": "app.widgetboard.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyRTE5QkU3NDdDNkY2QjAKUldTdzlzWkg1NXZoWXZzSjlhNWI2Q1VDSWRGT0x1N3dlNUJRU0VRekI5RUFMZzRydUxHdU94NWgK",
      "endpoints": ["https://github.com/104-bookwyrm/WidgetBoard/releases/latest/download/latest-installer.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
