{
  "_about": "Korean copy rules for tests/copy-glossary.mjs. The readable version is ui/locales/ko/GLOSSARY.md. Each term bans a regex; `keys` limits a ban to keys with those prefixes (a word banned in one context can be the standard word in another), `allowKeys` exempts keys, and `allow` phrases are removed before matching.",
  "skip": ["_name", "demo.sample.", "lay.sample.", "themes.seed.", "ck.stamp", "set.g."],
  "allow": ["Google 캘린더", "사진 폴더", "바느질 모양", "사용자 지정 휴일"],
  "patterns": [
    { "re": "니다", "why": "해요체: ~해요/~했어요" },
    { "re": "니까\\?", "why": "확인 질문은 ~하시겠어요?" },
    { "re": "십시오", "why": "지시는 ~하세요, 오류 뒤 행동은 ~해 주세요" },
    { "re": "\\(으\\)로|을\\(를\\)|이\\(가\\)|은\\(는\\)", "why": "플레이스홀더 뒤 조사 금지" },
    { "re": "\\u2014", "why": "em-dash 금지" },
    { "re": "\\.$", "why": "끝 마침표 없음", "skipFiles": ["help.json"] }
  ],
  "terms": [
    { "use": "편집 모드", "ban": "레이아웃 편집" },
    { "use": "위젯 프리셋 / 보드 캡처 / 위젯 배치 방식 / 미리보기 방식", "ban": "레이아웃" },
    { "use": "위젯 보관함", "ban": "위젯 메뉴" },
    { "use": "위젯 추가 (탭)", "ban": "둘러보기" },
    { "use": "트레이 메뉴", "ban": "작업 표시줄 메뉴" },
    { "use": "노트 (그룹)", "ban": "기록", "keys": ["group.notes"] },
    { "use": "변경 기록", "ban": "^기록$", "keys": ["lib.history"] },
    { "use": "랩", "ban": "랩 기록" },
    { "use": "이 위젯만 보기", "ban": "집중 모드" },
    { "use": "테마 / 꾸미기", "ban": "모양" },
    { "use": "테두리", "ban": "테두리 선" },
    { "use": "장식 프레임", "ban": "테두리 장식" },
    { "use": "프레임 없음", "ban": "액자" },
    { "use": "캘린더", "ban": "달력" },
    { "use": "일정", "ban": "이벤트" },
    { "use": "할 일", "ban": "항목|목표", "keys": ["ck.", "gal.checklist.", "help.guide.checklist."] },
    { "use": "플래너 (그룹)", "ban": "일정", "keys": ["group.plan"] },
    { "use": "이미지", "ban": "사진" },
    { "use": "갤러리", "ban": "그리드" },
    { "use": "트랙", "ban": "(?<![가-힣])곡(?![가-힣])" },
    { "use": "볼륨", "ban": "음량" },
    { "use": "드래그", "ban": "끌(어|면|고|다)" },
    { "use": "보이기 / 숨기기", "ban": "표시(돼|되|하|해)" },
    { "use": "항상 위에", "ban": "항상 위에 표시" },
    { "use": "최근 삭제", "ban": "최근 삭제된" },
    { "use": "완전 삭제", "ban": "영구 삭제" },
    { "use": "복구 (보관함)", "ban": "복원", "keys": ["lib."] },
    { "use": "실행 취소 / 이전 테마로 / 이전 프리셋으로", "ban": "되돌리기" },
    { "use": "초기화", "ban": "새로 세기" },
    { "use": "재개", "ban": "계속", "keys": ["timer.", "sw.", "pomo."] },
    { "use": "설정 (동사)", "ban": "지정|정하기", "allowKeys": ["set.cal.custom"] },
    { "use": "튜토리얼 / 체험 / 가이드", "ban": "연습" },
    { "use": "모니터", "ban": "디스플레이" },
    { "use": "모니터", "ban": "화면", "keys": ["toast.reflowed", "lay.partial"] },
    { "use": "삭제 (위젯 닫기)", "ban": "닫(기|아|거나|으면)", "allowKeys": ["theme.close", "set.close", "alarm.caption_muted", "timer.caption_muted", "pomo.caption_muted"] },
    { "use": "격자 맞춤", "ban": "칸에 맞춤" },
    { "use": "기타", "ban": "그외|그 외" },
    { "use": "위젯 종류 바꾸기", "ban": "다른 위젯으로 바꾸기" },
    { "use": "전환 간격", "ban": "슬라이드쇼 전환" }
  ]
}
